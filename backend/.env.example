MONGODB_URI=
MONGODB_DB_NAME=threatintel_demo

# Demo login credentials for POST /api/login (local demo only — never commit real values)
DEMO_LOGIN_USERNAME=
DEMO_LOGIN_PASSWORD=

# Local demo admin credentials for /api/admin/login (guards login-security endpoints)
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=

# Optional: admin session lifetime in minutes (default 30, max 240)
ADMIN_SESSION_MINUTES=

# Optional: set to "true", a hop count, or a proxy IP/CIDR to trust X-Forwarded-For.
# Leave unset to always use the direct socket address as the client IP.
TRUST_PROXY=
